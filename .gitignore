# Environment variables — NEVER commit these
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Data files (large, generated)
data/raw/
# data/clean/ and data/vectordb/ are intentionally tracked so Render has the
# pre-built index — commit them from your local machine after indexing.

# Node / UI
ui/node_modules/
ui/dist/

# Misc
.DS_Store
*.log
